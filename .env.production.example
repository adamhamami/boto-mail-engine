# ─── Production template — copy to .env on the server (NEVER commit secrets) ──
# Guides ops : docs/production/README.md
# Checklist GO : docs/production/00-CHECKLIST.md
# Install     : docs/production/01-INSTALLATION.md
# Laisser DRY_RUN=true et PRODUCTION_SENDING_ENABLED=false jusqu'à GO signé.
NODE_ENV=production
APP_NAME="BotoSchool Email Platform"
APP_URL=https://email.botoschool.com
AUTH_URL=https://email.botoschool.com

# Generate with: npm run secrets:generate
AUTH_SECRET=
# Rotation JWT : coller l'ancien AUTH_SECRET ici pendant la bascule
AUTH_SECRET_PREVIOUS=
# AUTH_SESSION_MAX_AGE_SECONDS=2592000

WEBHOOK_SECRET=

# Internal Docker network URLs (when using docker compose --profile production)
DATABASE_URL=postgresql://botoschool:CHANGE_ME_DB_PASSWORD@postgres:5432/botoschool_email?schema=public
REDIS_URL=redis://redis:6379

POSTGRES_USER=botoschool
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=botoschool_email

# ─── Real SMTP (required for production sends) ───────────────────────────────
# Guide Étape 9 : docs/production/05-SMTP.md · npm run smtp:checklist
# smtp | brevo | mailgun | postmark | ses | sendgrid
# Presets d'hôte/port/chiffrement :
#   brevo    → smtp-relay.brevo.com:587 STARTTLS   (user = login, pass = clé SMTP)
#   mailgun  → smtp.mailgun.org:587 STARTTLS       (EU: SMTP_HOST=smtp.eu.mailgun.org)
#   postmark → smtp.postmarkapp.com:587 STARTTLS   (user = pass = Server API Token)
#   ses      → email-smtp.<SES_REGION>.amazonaws.com:587 STARTTLS (SMTP creds SES ≠ IAM)
#   sendgrid → smtp.sendgrid.net:587 STARTTLS      (user = littéralement "apikey")
# Ne définir SMTP_HOST/SMTP_PORT/SMTP_SECURE que pour surcharger un preset.
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="BotoSchool"
SMTP_FROM_EMAIL=noreply@botoschool.com
# Obligatoire si DRY_RUN=false + PRODUCTION_SENDING_ENABLED=true.
# Doit contenir l'hôte RÉSOLU (preset inclus, ex. smtp-relay.brevo.com).
SMTP_HOST_ALLOWLIST=smtp.your-provider.com
# Refuse l'envoi en clair si STARTTLS est indisponible (défaut prod : true)
SMTP_REQUIRE_TLS=true
SES_REGION=eu-west-1

# Rampe production contrôlée (Étape 10) — 10→50→100→500→1000→progressif
# Voir docs/production/12-PRODUCTION-CONTROLEE.md · npm run ramp:checklist
# SEND_QUOTA_PER_HOUR=5
# SEND_QUOTA_PER_DAY=10
# SEND_QUOTA_PER_CAMPAIGN=10

# ─── Santé SMTP (/ops/smtp) ──────────────────────────────────────────────────
SMTP_HEALTH_PROBE_ENABLED=true
SMTP_HEALTH_CACHE_TTL_MS=300000
SMTP_PROBE_TIMEOUT_MS=8000
# Lecture du quota fournisseur — identifiants LECTURE SEULE, jamais l'envoi.
# Brevo : clé API v3. SES : IAM limité à ses:GetAccount.
BREVO_API_KEY=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# ─── Santé DNS (/ops/dns) ────────────────────────────────────────────────────
# Sélecteurs DKIM fournis par l'ESP (CSV). Vide = presets MAIL_PROVIDER.
DKIM_SELECTORS=
DNS_HEALTH_CACHE_TTL_MS=300000
DNS_PROBE_TIMEOUT_MS=5000

# ─── Monitoring / alertes (/ops/monitoring) ──────────────────────────────────
MONITORING_METRICS_WINDOW_MINUTES=60
ALERT_DLQ_MAX=0
ALERT_QUEUE_WAITING_MAX=500
ALERT_BOUNCE_RATE_MAX=0.05
ALERT_FAILURE_RATE_MAX=0.1
ALERT_RETRIES_MAX=50
ALERT_WORKER_STALE_MS=60000
ALERT_CPU_PERCENT_MAX=90
ALERT_RAM_PERCENT_MAX=90
WORKER_HEARTBEAT_INTERVAL_MS=15000

# Haute disponibilité — multi-worker / multi-API / Redis partagé
HA_LEADER_TTL_MS=15000
HA_SHUTDOWN_TIMEOUT_MS=30000
HA_SEND_LOCK_TTL_MS=120000
RATE_LIMIT_STORE=redis

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

EMAIL_QUEUE_CONCURRENCY=5
EMAIL_QUEUE_MAX_RETRIES=3
EMAIL_QUEUE_BACKOFF_MS=5000
EMAIL_QUEUE_BACKOFF_JITTER_MS=1000
EMAIL_QUEUE_COMPLETE_RETENTION_COUNT=1000
EMAIL_QUEUE_COMPLETE_RETENTION_AGE_SEC=86400
EMAIL_QUEUE_FAIL_RETENTION_COUNT=5000
EMAIL_QUEUE_FAIL_RETENTION_AGE_SEC=604800
DASHBOARD_CACHE_TTL_SECONDS=30
LOG_LEVEL=info
LOG_JSON=true
# Optionnel : fichiers locaux en plus de stdout Docker
# LOG_TO_FILE=true
# LOG_DIR=/var/log/botoschool
# LOG_MAX_SIZE=20m
# LOG_MAX_FILES=14
# LOG_COMPRESS=true
WORKER_ENABLED=true

# Backup (Phase 10) — cron host : scripts/backup/schedule.sh production
BACKUP_DIR=backups
BACKUP_COMPOSE_FILE=docker-compose.production.yml
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_COUNT=30
IMPORT_TMP_DIR=.tmp/imports

# Conformité CNDP / Loi 09-08 (Phase 13)
COMPLIANCE_CONTROLLER_NAME="BotoSchool — Plateforme Email"
COMPLIANCE_DPO_EMAIL=dpo@botoschool.com
DATA_RETENTION_ENABLED=false
DATA_RETENTION_SOFT_DELETE_DAYS=90
DATA_RETENTION_EVENT_DAYS=365
DATA_RETENTION_AUDIT_DAYS=730
DATA_RETENTION_INTERVAL_MS=86400000

CSP_ENABLED=true
CSP_REPORT_ONLY=false

IMPORT_MAX_FILE_BYTES=5242880
IMPORT_MAX_ROWS=10000

WEBHOOK_MAX_AGE_SECONDS=300
WEBHOOK_MAX_PAYLOAD_BYTES=65536

SEND_QUOTA_PER_HOUR=200
SEND_QUOTA_PER_DAY=2000
SEND_QUOTA_PER_CONNECTOR=200
SEND_QUOTA_PER_SENDER_DOMAIN=2000
SEND_QUOTA_PER_CAMPAIGN=100

CAMPAIGN_DEFAULT_TIMEZONE=Africa/Casablanca
SEND_WINDOW_START_HOUR=9
SEND_WINDOW_END_HOUR=18
SEND_WINDOW_WEEKDAYS=1,2,3,4,5

TEST_EMAIL_ALLOWLIST=
TEST_DOMAIN_ALLOWLIST=
SMTP_ALLOWED_NODE_ENVS=production
ALLOW_TEST_SMTP=false

# CDC — ne passer à false/true qu'après recette R-01→R-10 + checklist pilote signée
DRY_RUN=true
PRODUCTION_SENDING_ENABLED=false
