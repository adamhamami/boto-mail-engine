// BotoSchool Email Prospecting Platform — Database Schema
// PostgreSQL + Prisma 7

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// CDC: IMPORTÉ → À_REVOIR → ÉLIGIBLE → EN_SÉQUENCE → RÉPONDU / DÉSINSCRIT / REBOND_DUR / BLOQUÉ
enum ContactStatus {
  IMPORTED
  TO_REVIEW
  ELIGIBLE
  DISQUALIFIED
  IN_SEQUENCE
  RESPONDED
  UNSUBSCRIBED
  HARD_BOUNCED
  BLOCKED
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

/// CDC: BROUILLON → TESTÉE → PROGRAMMÉE → EN_COURS → PAUSÉE → TERMINÉE / ANNULÉE
enum CampaignStatus {
  DRAFT
  TESTED
  PENDING_VALIDATION
  VALIDATED
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum SendAttemptStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  BOUNCED
  SKIPPED
}

enum EventType {
  EMAIL_SENT
  EMAIL_OPENED
  EMAIL_CLICKED
  EMAIL_REPLIED
  EMAIL_BOUNCED
  EMAIL_UNSUBSCRIBED
  EMAIL_COMPLAINED
  EMAIL_DELIVERED
  EMAIL_PROVIDER_ERROR
  CAMPAIGN_STARTED
  CAMPAIGN_COMPLETED
  CAMPAIGN_VALIDATED
  IMPORT_COMPLETED
}

enum SuppressionReason {
  UNSUBSCRIBE
  BOUNCE_HARD
  BOUNCE_SOFT
  COMPLAINT
  MANUAL
  GDPR
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  VALIDATE
  SEND
  IMPORT
  APPROVE
  REJECT
  /// Phase 13 — conformité CNDP / Loi 09-08
  ANONYMIZE
  ERASE
  RETENTION
  ACCESS
}

/// Demande personne concernée (CNDP / Loi 09-08)
enum DataSubjectRequestType {
  ACCESS
  EXPORT
  RECTIFICATION
  ERASURE
  OBJECTION
  RESTRICTION
}

enum DataSubjectRequestStatus {
  RECEIVED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum WebhookEventStatus {
  PENDING
  PROCESSED
  FAILED
  IGNORED
}

enum SequenceStepType {
  EMAIL
  DELAY
}

enum RecipientStepStatus {
  PENDING
  SCHEDULED
  QUEUED
  SENT
  SKIPPED
  STOPPED
  FAILED
}

enum SalesTaskType {
  REPLY_FOLLOW_UP
  DEMO_REQUEST
  QUALIFICATION
  OTHER
}

enum SalesTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum SalesTaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum EmailDuplicateResolutionStatus {
  DETECTED
  MARKED_DUPLICATE
  MERGED
  DISMISSED
}

// ─── Auth.js ─────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── RBAC ────────────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?  @map("email_verified")
  name          String?
  passwordHash  String?    @map("password_hash")
  image         String?
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?  @map("last_login_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at")

  accounts  Account[]
  sessions  Session[]
  userRoles UserRole[]

  createdOrganizations Organization[] @relation("OrganizationCreatedBy")
  updatedOrganizations Organization[] @relation("OrganizationUpdatedBy")
  createdContacts      Contact[]      @relation("ContactCreatedBy")
  updatedContacts      Contact[]      @relation("ContactUpdatedBy")
  ownedContacts        Contact[]      @relation("ContactOwner")
  createdImports       ImportBatch[]  @relation("ImportCreatedBy")
  createdSegments      Segment[]      @relation("SegmentCreatedBy")
  updatedSegments      Segment[]      @relation("SegmentUpdatedBy")
  createdTemplates     Template[]     @relation("TemplateCreatedBy")
  updatedTemplates     Template[]     @relation("TemplateUpdatedBy")
  createdSequences     Sequence[]     @relation("SequenceCreatedBy")
  updatedSequences     Sequence[]     @relation("SequenceUpdatedBy")
  createdCampaigns     Campaign[]     @relation("CampaignCreatedBy")
  updatedCampaigns     Campaign[]     @relation("CampaignUpdatedBy")
  validatedCampaigns   Campaign[]     @relation("CampaignValidatedBy")
  auditLogs            AuditLog[]
  createdSuppressions  SuppressionList[] @relation("SuppressionCreatedBy")
  ownedSalesTasks      SalesTask[]    @relation("SalesTaskOwner")
  createdSalesTasks    SalesTask[]    @relation("SalesTaskCreatedBy")
  emailDuplicateResolutions EmailDuplicateResolution[] @relation("EmailDuplicateResolvedBy")
  createdDataSubjectRequests  DataSubjectRequest[] @relation("DataSubjectRequestCreatedBy")
  assignedDataSubjectRequests DataSubjectRequest[] @relation("DataSubjectRequestAssignedTo")

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ─── Organizations & Contacts ────────────────────────────────────────────────

model Organization {
  id          String    @id @default(cuid())
  name        String
  domain      String?
  industry    String?
  size        String?
  website     String?
  address     String?
  city        String?
  country     String?
  notes       String?   @db.Text
  tags        String[]  @default([])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  createdBy User? @relation("OrganizationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("OrganizationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  contacts  Contact[]

  @@index([name])
  @@index([domain])
  @@index([deletedAt])
  @@map("organizations")
}

model Contact {
  id               String        @id @default(cuid())
  /// Adresse affichée / saisie (peut conserver la casse d’origine)
  email            String
  /// Forme canonique : trim + lowercase — unicité partielle en SQL (actifs non-doublons)
  emailNormalized  String        @map("email_normalized")
  firstName        String?       @map("first_name")
  lastName         String?       @map("last_name")
  phone            String?
  jobTitle         String?       @map("job_title")
  city             String?
  status           ContactStatus @default(IMPORTED)
  score            Int           @default(0)
  tags             String[]      @default([])
  customFields     Json          @default("{}") @map("custom_fields")
  /// Source du contact (CDC — justification de prospection)
  source           String?
  /// Base légale / autorisation documentée (CDC)
  consentBase      String?       @map("consent_base")
  eligibilityNotes String?       @map("eligibility_notes") @db.Text
  /// Liste interne de test (mode test, max 10)
  isTestRecipient  Boolean       @default(false) @map("is_test_recipient")
  isDuplicate      Boolean       @default(false) @map("is_duplicate")
  duplicateOfId    String?       @map("duplicate_of_id")
  organizationId   String?       @map("organization_id")
  importBatchId    String?       @map("import_batch_id")
  /// Responsable commercial (CDC — filtre segments)
  ownerId          String?       @map("owner_id")
  lastContactedAt  DateTime?     @map("last_contacted_at")
  /// Phase 13 — gel conservation / litige (bloque anonymisation auto)
  legalHold        Boolean       @default(false) @map("legal_hold")
  /// Horodatage anonymisation CNDP (PII effacée, stub conservé)
  anonymizedAt     DateTime?     @map("anonymized_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")
  createdById      String?       @map("created_by_id")
  updatedById      String?       @map("updated_by_id")

  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  importBatch        ImportBatch?        @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  owner              User?               @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  duplicateOf        Contact?            @relation("ContactDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates         Contact[]           @relation("ContactDuplicates")
  createdBy          User?               @relation("ContactCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy          User?               @relation("ContactUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  segmentContacts    SegmentContact[]
  campaignRecipients CampaignRecipient[]
  events             Event[]
  suppressions       SuppressionList[]
  salesTasks         SalesTask[]
  emailDuplicateAsCanonical EmailDuplicateResolution[] @relation("EmailDuplicateCanonical")
  dataSubjectRequests DataSubjectRequest[]

  @@index([email])
  @@index([emailNormalized])
  @@index([status])
  @@index([status, deletedAt])
  @@index([organizationId])
  @@index([ownerId])
  @@index([isDuplicate])
  @@index([deletedAt])
  @@index([anonymizedAt])
  @@index([legalHold])
  @@index([city])
  @@map("contacts")
}

// ─── Imports ─────────────────────────────────────────────────────────────────

model ImportBatch {
  id                 String       @id @default(cuid())
  filename           String
  mimeType           String       @map("mime_type")
  status             ImportStatus @default(PENDING)
  totalRows          Int          @default(0) @map("total_rows")
  processedRows      Int          @default(0) @map("processed_rows")
  successRows        Int          @default(0) @map("success_rows")
  errorRows          Int          @default(0) @map("error_rows")
  duplicateRows      Int          @default(0) @map("duplicate_rows")
  rejectedRows       Int          @default(0) @map("rejected_rows")
  suppressedRows     Int          @default(0) @map("suppressed_rows")
  fileSizeBytes      Int          @default(0) @map("file_size_bytes")
  /// Chemin temporaire sécurisé (purge après traitement)
  tempFilePath       String?      @map("temp_file_path")
  headers            Json         @default("[]")
  columnMapping      Json         @default("{}") @map("column_mapping")
  errors             Json         @default("[]")
  mappingConfirmedAt DateTime?    @map("mapping_confirmed_at")
  startedAt          DateTime?    @map("started_at")
  completedAt        DateTime?    @map("completed_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  createdById        String?      @map("created_by_id")

  createdBy User?     @relation("ImportCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  contacts  Contact[]

  @@index([status])
  @@index([createdAt])
  @@map("import_batches")
}

// ─── Segments ────────────────────────────────────────────────────────────────

model Segment {
  id           String    @id @default(cuid())
  name         String
  description  String?   @db.Text
  filters      Json      @default("{}")
  isDynamic    Boolean   @default(true) @map("is_dynamic")
  contactCount Int       @default(0) @map("contact_count")
  /// Incrémenté à chaque modification matérielle des filtres
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  createdById  String?   @map("created_by_id")
  updatedById  String?   @map("updated_by_id")

  createdBy       User?            @relation("SegmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?            @relation("SegmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  segmentContacts SegmentContact[]
  campaigns       Campaign[]

  @@index([deletedAt])
  @@index([version])
  @@map("segments")
}

model SegmentContact {
  id        String   @id @default(cuid())
  segmentId String   @map("segment_id")
  contactId String   @map("contact_id")
  addedAt   DateTime @default(now()) @map("added_at")

  segment Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([segmentId, contactId])
  @@index([contactId])
  @@map("segment_contacts")
}

// ─── Templates & Sequences ───────────────────────────────────────────────────

model Template {
  id          String    @id @default(cuid())
  name        String
  subject     String
  bodyHtml    String    @map("body_html") @db.Text
  bodyText    String?   @map("body_text") @db.Text
  variables   String[]  @default([])
  isActive    Boolean   @default(true) @map("is_active")
  /// Version incrémentée à chaque modification de contenu
  version     Int       @default(1)
  contentHash String?   @map("content_hash")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  createdBy     User?          @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?          @relation("TemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  sequenceSteps SequenceStep[]
  campaigns     Campaign[]

  @@index([isActive])
  @@index([deletedAt])
  @@index([version])
  @@map("templates")
}

model Sequence {
  id          String    @id @default(cuid())
  name        String
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  /// Version incrémentée à chaque modification d’étapes / contenu
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")

  createdBy User?          @relation("SequenceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?          @relation("SequenceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  steps     SequenceStep[]
  campaigns Campaign[]

  @@index([isActive])
  @@index([deletedAt])
  @@index([version])
  @@map("sequences")
}

model SequenceStep {
  id           String           @id @default(cuid())
  sequenceId   String           @map("sequence_id")
  templateId   String?          @map("template_id")
  stepOrder    Int              @map("step_order")
  type         SequenceStepType @default(EMAIL)
  delayDays    Int              @default(0) @map("delay_days")
  delayHours   Int              @default(0) @map("delay_hours")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  sequence Sequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  template Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([sequenceId, stepOrder])
  @@index([sequenceId])
  @@map("sequence_steps")
}

// ─── Campaigns ─────────────────────────────────────────────────────────────────

model Campaign {
  id               String         @id @default(cuid())
  name             String
  description      String?        @db.Text
  status           CampaignStatus @default(DRAFT)
  /// Mode test CDC : max 10 destinataires internes, aucun quota prod
  isTestMode       Boolean        @default(true) @map("is_test_mode")
  segmentId        String?        @map("segment_id")
  templateId       String?        @map("template_id")
  sequenceId       String?        @map("sequence_id")
  scheduledAt      DateTime?      @map("scheduled_at")
  startedAt        DateTime?      @map("started_at")
  completedAt      DateTime?      @map("completed_at")
  testedAt         DateTime?      @map("tested_at")
  validatedAt      DateTime?      @map("validated_at")
  validatedById    String?        @map("validated_by_id")
  /// Preuve immuable d’approbation (filtres, versions, hash, quotas…)
  approvalSnapshot Json?          @map("approval_snapshot")
  approvedContentHash String?     @map("approved_content_hash")
  totalRecipients  Int            @default(0) @map("total_recipients")
  sentCount        Int            @default(0) @map("sent_count")
  openCount        Int            @default(0) @map("open_count")
  clickCount       Int            @default(0) @map("click_count")
  replyCount       Int            @default(0) @map("reply_count")
  bounceCount      Int            @default(0) @map("bounce_count")
  unsubscribeCount Int            @default(0) @map("unsubscribe_count")
  settings         Json           @default("{}")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")
  createdById      String?        @map("created_by_id")
  updatedById      String?        @map("updated_by_id")

  segment     Segment?            @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  template    Template?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sequence    Sequence?           @relation(fields: [sequenceId], references: [id], onDelete: SetNull)
  validatedBy User?               @relation("CampaignValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)
  createdBy   User?               @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?               @relation("CampaignUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  recipients  CampaignRecipient[]
  events      Event[]
  salesTasks  SalesTask[]

  @@index([status])
  @@index([scheduledAt])
  @@index([deletedAt])
  @@index([validatedAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id               String              @id @default(cuid())
  campaignId       String              @map("campaign_id")
  contactId        String              @map("contact_id")
  sequenceStep     Int                 @default(0) @map("sequence_step")
  sequenceStepId   String?             @map("sequence_step_id")
  /// Version de séquence figée au moment de la programmation
  sequenceVersion  Int                 @default(1) @map("sequence_version")
  /// Template figé pour cette étape (version approuvée)
  templateId       String?             @map("template_id")
  contentVersion   Int?                @map("content_version")
  /// Instant UTC non ambigu de programmation de l’étape
  scheduledAt      DateTime?           @map("scheduled_at")
  status           RecipientStepStatus @default(PENDING)
  skipReason       String?             @map("skip_reason")
  isSent           Boolean             @default(false) @map("is_sent")
  isStopped        Boolean             @default(false) @map("is_stopped")
  stopReason       String?             @map("stop_reason")
  unsubscribeToken String              @unique @default(cuid()) @map("unsubscribe_token")
  sentAt           DateTime?           @map("sent_at")
  openedAt         DateTime?           @map("opened_at")
  clickedAt        DateTime?           @map("clicked_at")
  repliedAt        DateTime?           @map("replied_at")
  bouncedAt        DateTime?           @map("bounced_at")
  unsubscribedAt   DateTime?           @map("unsubscribed_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sendAttempts SendAttempt[]

  @@unique([campaignId, contactId, sequenceStep, sequenceVersion])
  @@index([campaignId])
  @@index([contactId])
  @@index([isSent])
  @@index([isStopped])
  @@index([status])
  @@index([scheduledAt])
  @@index([campaignId, isStopped, isSent])
  @@index([campaignId, status, scheduledAt])
  @@map("campaign_recipients")
}

model SendAttempt {
  id                  String            @id @default(cuid())
  campaignRecipientId String            @map("campaign_recipient_id")
  status              SendAttemptStatus @default(QUEUED)
  attemptNumber       Int               @default(1) @map("attempt_number")
  idempotencyKey      String            @unique @map("idempotency_key")
  providerMessageId   String?           @map("provider_message_id")
  errorMessage        String?           @map("error_message") @db.Text
  queuedAt            DateTime          @default(now()) @map("queued_at")
  processedAt         DateTime?         @map("processed_at")
  sentAt              DateTime?         @map("sent_at")
  metadata            Json              @default("{}")

  campaignRecipient CampaignRecipient @relation(fields: [campaignRecipientId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([campaignRecipientId])
  @@index([status, queuedAt])
  @@index([providerMessageId])
  @@map("send_attempts")
}

// ─── Events & Audit ──────────────────────────────────────────────────────────

model Event {
  id         String    @id @default(cuid())
  type       EventType
  campaignId String?   @map("campaign_id")
  contactId  String?   @map("contact_id")
  metadata   Json      @default("{}")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent") @db.Text
  occurredAt DateTime  @default(now()) @map("occurred_at")

  campaign   Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contact    Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  salesTasks SalesTask[]

  @@index([type])
  @@index([campaignId])
  @@index([contactId])
  @@index([occurredAt])
  @@index([type, occurredAt])
  @@map("events")
}

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  module     String
  entityType String      @map("entity_type")
  entityId   String?     @map("entity_id")
  userId     String?     @map("user_id")
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent") @db.Text
  oldValues  Json?       @map("old_values")
  newValues  Json?       @map("new_values")
  metadata   Json        @default("{}")
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([module])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([module, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ─── Suppression & Webhooks ────────────────────────────────────────────────────

model SuppressionList {
  id              String            @id @default(cuid())
  email           String
  emailNormalized String            @map("email_normalized")
  reason          SuppressionReason
  contactId       String?           @map("contact_id")
  source          String?
  notes           String?           @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  createdById     String?           @map("created_by_id")

  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("SuppressionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([emailNormalized])
  @@index([email])
  @@index([reason])
  @@map("suppression_list")
}

model SalesTask {
  id          String            @id @default(cuid())
  contactId   String            @map("contact_id")
  campaignId  String?           @map("campaign_id")
  eventId     String?           @map("event_id")
  type        SalesTaskType     @default(REPLY_FOLLOW_UP)
  status      SalesTaskStatus   @default(OPEN)
  priority    SalesTaskPriority @default(MEDIUM)
  ownerId     String?           @map("owner_id")
  title       String
  /// Résumé minimisé — pas le corps email complet
  summary     String?           @db.Text
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  dueAt       DateTime?         @map("due_at")
  completedAt DateTime?         @map("completed_at")
  createdById String?           @map("created_by_id")

  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  event     Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  owner     User?     @relation("SalesTaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("SalesTaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([contactId])
  @@index([campaignId])
  @@index([ownerId])
  @@index([dueAt])
  @@map("sales_tasks")
}

/// Traçabilité des conflits email — aucune fusion automatique
model EmailDuplicateResolution {
  id                 String                         @id @default(cuid())
  emailNormalized    String                         @map("email_normalized")
  contactIds         String[]                       @map("contact_ids")
  canonicalContactId String?                        @map("canonical_contact_id")
  status             EmailDuplicateResolutionStatus @default(DETECTED)
  notes              String?                        @db.Text
  detectedAt         DateTime                       @default(now()) @map("detected_at")
  resolvedAt         DateTime?                      @map("resolved_at")
  resolvedById       String?                        @map("resolved_by_id")

  canonicalContact Contact? @relation("EmailDuplicateCanonical", fields: [canonicalContactId], references: [id], onDelete: SetNull)
  resolvedBy       User?    @relation("EmailDuplicateResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([emailNormalized])
  @@index([status])
  @@index([detectedAt])
  @@map("email_duplicate_resolutions")
}

model WebhookEvent {
  id              String             @id @default(cuid())
  provider        String
  /// Identifiant fournisseur pour idempotence (unique avec provider)
  providerEventId String             @map("provider_event_id")
  eventType       String             @map("event_type")
  /// Payload minimisé (pas de corps email complet)
  payload         Json
  status          WebhookEventStatus @default(PENDING)
  processedAt     DateTime?          @map("processed_at")
  errorMessage    String?            @map("error_message") @db.Text
  createdAt       DateTime           @default(now()) @map("created_at")

  @@unique([provider, providerEventId])
  @@index([provider, eventType])
  @@index([status])
  @@index([createdAt])
  @@map("webhook_events")
}

// ─── Application Settings ──────────────────────────────────────────────────────

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  isSecret  Boolean  @default(false) @map("is_secret")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ─── Conformité CNDP / Loi 09-08 (Phase 13) ───────────────────────────────────

model DataSubjectRequest {
  id              String                     @id @default(cuid())
  type            DataSubjectRequestType
  status          DataSubjectRequestStatus   @default(RECEIVED)
  /// Email déclaré par le demandeur (peut différer du contact lié)
  email           String
  emailNormalized String                     @map("email_normalized")
  contactId       String?                    @map("contact_id")
  requesterName   String?                    @map("requester_name")
  notes           String?                    @db.Text
  /// Justification / base légale de traitement de la demande
  legalBasis      String?                    @map("legal_basis")
  /// Échéance indicative (défaut +30 j à la création)
  dueAt           DateTime                   @map("due_at")
  completedAt     DateTime?                  @map("completed_at")
  resultSummary   String?                    @map("result_summary") @db.Text
  createdById     String?                    @map("created_by_id")
  assignedToId    String?                    @map("assigned_to_id")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdBy  User?    @relation("DataSubjectRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo User?    @relation("DataSubjectRequestAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([emailNormalized])
  @@index([contactId])
  @@index([dueAt])
  @@index([createdAt])
  /// File compliance : filtres status + échéance
  @@index([status, dueAt])
  @@map("data_subject_requests")
}
