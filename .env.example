# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME="BotoSchool Email Platform"
APP_URL=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://botoschool:botoschool_secret@127.0.0.1:5433/botoschool_email?schema=public"

# ─── Redis (BullMQ) ────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth.js (npm run secrets:generate) ──────────────────────────────────────
# Production: obligatoire, ≥32 chars, pas de valeur placeholder. Sans secret → démarrage refusé.
# Dev/test: si absent, un secret de test explicite est utilisé (jamais en production).
AUTH_SECRET="generate-a-strong-secret-min-32-chars-here"
AUTH_URL=http://localhost:3000

# ─── SMTP ────────────────────────────────────────────────────────────────────
# Local: npm run docker:tools → Mailpit UI http://localhost:8025
# Prod: set your real provider credentials
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="BotoSchool"
SMTP_FROM_EMAIL=noreply@botoschool.com

# ─── Mail Provider ───────────────────────────────────────────────────────────
# smtp | brevo | mailgun | postmark | ses | sendgrid
# Chaque connecteur a un preset (hôte/port/chiffrement) ; SMTP_HOST, SMTP_PORT
# et SMTP_SECURE ne sont à définir que pour surcharger le preset.
MAIL_PROVIDER=smtp

# Amazon SES : région du relais SMTP
# SES_REGION=eu-west-1

# ─── Santé SMTP (page /ops/smtp) ─────────────────────────────────────────────
# La sonde n'envoie aucun email : poignée de main + AUTH uniquement.
SMTP_HEALTH_PROBE_ENABLED=true
SMTP_HEALTH_CACHE_TTL_MS=300000
SMTP_PROBE_TIMEOUT_MS=8000
# Refuser l'envoi si STARTTLS indisponible. Défaut : true en production.
# Laisser vide en local (Mailpit n'expose pas TLS).
# SMTP_REQUIRE_TLS=

# Lecture du quota fournisseur (optionnel, lecture seule, jamais l'envoi)
# BREVO_API_KEY=
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=

# ─── Santé DNS (page /ops/dns) ───────────────────────────────────────────────
# Sélecteurs DKIM CSV — vide = presets selon MAIL_PROVIDER
# DKIM_SELECTORS=mail,brevo
DNS_HEALTH_CACHE_TTL_MS=300000
DNS_PROBE_TIMEOUT_MS=5000

# ─── Monitoring / alertes (page /ops/monitoring) ─────────────────────────────
MONITORING_METRICS_WINDOW_MINUTES=60
ALERT_DLQ_MAX=0
ALERT_QUEUE_WAITING_MAX=500
ALERT_BOUNCE_RATE_MAX=0.05
ALERT_FAILURE_RATE_MAX=0.1
ALERT_RETRIES_MAX=50
ALERT_WORKER_STALE_MS=60000
ALERT_CPU_PERCENT_MAX=90
ALERT_RAM_PERCENT_MAX=90
WORKER_HEARTBEAT_INTERVAL_MS=15000

# ─── Haute disponibilité (Phase 6) ───────────────────────────────────────────
HA_LEADER_TTL_MS=15000
HA_SHUTDOWN_TIMEOUT_MS=30000
HA_SEND_LOCK_TTL_MS=120000
# auto | memory | redis — redis en multi-API production
RATE_LIMIT_STORE=auto

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# Anti brute-force login (séparé)
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# ─── Security headers / CSP ──────────────────────────────────────────────────
CSP_ENABLED=true
CSP_REPORT_ONLY=false
# AUTH_SECRET_PREVIOUS=  # rotation JWT
# SMTP_HOST_ALLOWLIST=   # requis si DRY_RUN=false + PRODUCTION_SENDING_ENABLED=true

# ─── Email Queue ─────────────────────────────────────────────────────────────
EMAIL_QUEUE_CONCURRENCY=5
EMAIL_QUEUE_MAX_RETRIES=3
EMAIL_QUEUE_BACKOFF_MS=5000
EMAIL_QUEUE_BACKOFF_JITTER_MS=1000
# Rétention jobs BullMQ (Phase 11) — borne mémoire Redis
EMAIL_QUEUE_COMPLETE_RETENTION_COUNT=1000
EMAIL_QUEUE_COMPLETE_RETENTION_AGE_SEC=86400
EMAIL_QUEUE_FAIL_RETENTION_COUNT=5000
EMAIL_QUEUE_FAIL_RETENTION_AGE_SEC=604800

# ─── Cache dashboard (Phase 11) — 0 = désactivé ──────────────────────────────
DASHBOARD_CACHE_TTL_SECONDS=30

# ─── Logging / Observabilité (Phase 5 + Étape 5) ─────────────────────────────
LOG_LEVEL=info
# JSON structuré (défaut true hors development)
# LOG_JSON=true
# Fichier rotaté (pino-roll) + gzip des archives
# LOG_TO_FILE=false
# LOG_DIR=logs
# LOG_MAX_SIZE=20m
# LOG_MAX_FILES=14
# LOG_COMPRESS=true
# Scrape Prometheus : Authorization Bearer (aligner avec monitoring/prometheus/scrape_token)
# METRICS_SCRAPE_TOKEN=
# Webhook JSON quand le set d'alertes in-app change
# ALERT_WEBHOOK_URL=
# Lien Grafana dans /ops/monitoring
# OBSERVABILITY_GRAFANA_URL=http://localhost:3010

# ─── Worker Process ──────────────────────────────────────────────────────────
WORKER_ENABLED=true

# ─── Backup (Phase 10) ───────────────────────────────────────────────────────
BACKUP_DIR=backups
BACKUP_COMPOSE_FILE=docker-compose.yml
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_COUNT=30
IMPORT_TMP_DIR=.tmp/imports

# ─── Conformité CNDP / Loi 09-08 (Phase 13) ──────────────────────────────────
COMPLIANCE_CONTROLLER_NAME="BotoSchool — Plateforme Email"
COMPLIANCE_DPO_EMAIL=
# false = job rétention ne purge pas (API dry-run toujours dispo)
DATA_RETENTION_ENABLED=false
DATA_RETENTION_SOFT_DELETE_DAYS=90
DATA_RETENTION_EVENT_DAYS=365
DATA_RETENTION_AUDIT_DAYS=730
DATA_RETENTION_INTERVAL_MS=86400000

# ─── CDC — sécurité d'envoi (non négociable) ─────────────────────────────────
# DRY_RUN=true ⇒ aucun SMTP/API, y compris campagnes de test.
DRY_RUN=true
PRODUCTION_SENDING_ENABLED=false

# SMTP réel de test (en plus de DRY_RUN=false + NODE_ENV dans SMTP_ALLOWED_NODE_ENVS)
ALLOW_TEST_SMTP=false

# Allowlist serveur pour destinataires de test (CSV). isTestRecipient seul est insuffisant.
TEST_EMAIL_ALLOWLIST=
TEST_DOMAIN_ALLOWLIST=

# Environnements autorisant un SMTP réel (CSV). Défaut production uniquement.
SMTP_ALLOWED_NODE_ENVS=production

# ─── Webhooks entrants (Phase 3) ─────────────────────────────────────────────
# Production: obligatoire ≥32 chars. Dev: défaut de test si absent.
WEBHOOK_SECRET="generate-a-strong-webhook-secret-min-32-chars"
WEBHOOK_MAX_AGE_SECONDS=300
WEBHOOK_MAX_PAYLOAD_BYTES=65536
SOFT_BOUNCE_MAX_RETRIES=3
AUTO_PAUSE_HARD_BOUNCE_RATE=0.05
AUTO_PAUSE_MIN_EVENTS=20

# IMAP (optionnel — ne pas inventer de credentials)
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=
# IMAP_MAILBOX=INBOX
# IMAP_TLS=true

# ─── Phase 4 — quotas / créneaux / auto-pause ────────────────────────────────
SEND_QUOTA_PER_HOUR=200
SEND_QUOTA_PER_DAY=2000
SEND_QUOTA_PER_CONNECTOR=200
SEND_QUOTA_PER_SENDER_DOMAIN=2000
SEND_QUOTA_PER_CAMPAIGN=100
CAMPAIGN_DEFAULT_TIMEZONE=Africa/Casablanca
SEND_WINDOW_START_HOUR=9
SEND_WINDOW_END_HOUR=18
SEND_WINDOW_WEEKDAYS=1,2,3,4,5
AUTO_PAUSE_COMPLAINT_RATE=0.02
AUTO_PAUSE_PROVIDER_ERROR_RATE=0.1
AUTO_PAUSE_VOLUME_ANOMALY_MULTIPLIER=3

# ─── Phase 5 — imports ───────────────────────────────────────────────────────
IMPORT_MAX_FILE_BYTES=5242880
IMPORT_MAX_ROWS=10000
