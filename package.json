    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "prisma": "^7.9.1",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nodemailer": "^9.0.3",
    "uuid": "^11.1.1",
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "brace-expansion": "^2.1.4",
    "@hono/node-server": "^2.0.12",
    "find-my-way": "^9.7.0",
    "valibot": "^1.4.2"
  }
}
