{
  "name": "botoschool-emailing",
  "version": "1.0.0",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "node scripts/analyze-bundle.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "perf:controlled": "tsx scripts/perf-controlled.ts",
    "perf:runtime": "tsx scripts/perf-runtime-measure.ts",
    "worker": "tsx src/workers/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:recette": "node scripts/run-recette.mjs",
    "validate:final": "node scripts/validate-final.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "audit:ci": "npm audit --omit=dev --audit-level=high",
    "audit:full": "npm audit",
    "deps:outdated": "npm outdated || true",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "docker:up": "docker compose up postgres redis -d",
    "docker:tools": "docker compose --profile tools up mailpit -d",
    "docker:monitoring": "node scripts/ensure-scrape-token.mjs && docker compose --profile monitoring up -d",
    "docker:secrets": "node scripts/prepare-docker-secrets.mjs",
    "docker:prod": "docker compose -f docker-compose.production.yml up -d --build",
    "docker:staging": "docker compose -f docker-compose.staging.yml up -d --build",
    "deploy:staging": "node scripts/run-deploy-staging.mjs",
    "smoke:staging": "node scripts/smoke-staging.mjs",
    "smoke:email": "tsx scripts/smoke-email-automation.ts",
    "dns:checklist": "node scripts/dns-checklist.mjs",
    "smtp:checklist": "node scripts/smtp-checklist.mjs",
    "ramp:checklist": "node scripts/production-ramp-checklist.mjs",
    "release:checklist": "node scripts/release-checklist.mjs",
    "docker:tag-release": "node scripts/docker-tag-release.mjs",
    "docker:down": "docker compose -f docker-compose.yml down",
    "docker:down:prod": "docker compose -f docker-compose.production.yml down",
    "docker:down:staging": "docker compose -f docker-compose.staging.yml down",
    "secrets:generate": "node scripts/generate-secrets.mjs",
    "env:validate": "tsx scripts/validate-env.ts",
    "admin:password": "tsx scripts/change-admin-password.ts",
    "db:detect-duplicates": "tsx scripts/detect-email-duplicates.ts",
    "deploy:docker": "powershell -ExecutionPolicy Bypass -File scripts/deploy-docker.ps1",
    "backup": "node scripts/backup/cli.mjs backup",
    "backup:all": "node scripts/backup/cli.mjs all",
    "backup:verify": "node scripts/backup/cli.mjs verify",
    "backup:restore": "node scripts/backup/cli.mjs restore",
    "backup:rotate": "node scripts/backup/cli.mjs rotate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
