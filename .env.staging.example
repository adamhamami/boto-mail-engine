# ─── Staging template — copy to .env.staging (NEVER commit secrets) ──────────
NODE_ENV=production
APP_NAME="BotoSchool Email Platform (Staging)"
APP_URL=http://localhost:3001
AUTH_URL=http://localhost:3001

# Remplis via : npm run docker:secrets
AUTH_SECRET=
WEBHOOK_SECRET=

POSTGRES_USER=botoschool
POSTGRES_PASSWORD=
POSTGRES_DB=botoschool_email_staging
POSTGRES_PORT=5434
REDIS_PORT=6380
APP_PORT=3001
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026

# Staging : Mailpit + DRY_RUN (surchargés aussi dans compose)
MAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="BotoSchool Staging"
SMTP_FROM_EMAIL=noreply-staging@botoschool.com

DRY_RUN=true
PRODUCTION_SENDING_ENABLED=false
ALLOW_TEST_SMTP=false
WORKER_ENABLED=true
LOG_JSON=true
RATE_LIMIT_STORE=redis
LOG_TO_FILE=true
LOG_DIR=/app/logs

# DNS probe (/ops/dns) — domaine From ; Mailpit n’envoie pas réel
# DKIM_SELECTORS=mail
# DNS_HEALTH_CACHE_TTL_MS=300000
# DNS_PROBE_TIMEOUT_MS=5000
# OBSERVABILITY_GRAFANA_URL=
